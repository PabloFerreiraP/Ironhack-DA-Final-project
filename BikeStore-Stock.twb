            <column caption='SUM([Stock Quantity])/SUM([Max Month Demand])' datatype='real' name='[Calculation_0658397519597572]' role='measure' type='quantitative' user:unnamed='Stock Level (4)'>
              <calculation class='tableau' formula='SUM([stock_quantity])/SUM([max_month_demand])' />
            </column>
            <column caption='(sum([Max Month Demand]) * 12) / SUM([Stock Quantity])' datatype='real' name='[Calculation_1169671063392269]' role='measure' type='quantitative' user:unnamed='Stock Level'>
              <calculation class='tableau' formula='(sum([max_month_demand]) * 12) / SUM([stock_quantity])' />
            </column>
            <column caption='SUM([Safety Stock])/2' datatype='real' name='[Calculation_1169671065980944]' role='measure' type='quantitative' user:unnamed='Stock Level'>
