            </column>
            <column caption='SUM([Stock Quantity]) / (SUM([Safety Stock])/2)' datatype='real' name='[Calculation_1169671066398739]' role='measure' type='quantitative' user:unnamed='Stock Level'>
              <calculation class='tableau' formula='SUM([stock_quantity]) / (SUM([safety_stock])/2)' />
            </column>
            <column caption='MAX(0, SUM([Safety Stock])/2 - SUM([Stock Quantity]))' datatype='real' name='[Calculation_1169671066566676]' role='measure' type='quantitative' user:unnamed='Stock Level'>
              <calculation class='tableau' formula='MAX(0, SUM([safety_stock])/2 - SUM([stock_quantity]))' />
            </column>
            <column caption='SUM([Stock Quantity]) / (SUM([Safety Stock])/2)' datatype='real' name='[Calculation_1169671066718229]' role='measure' type='quantitative' user:unnamed='Stock Level'>
